# App
MIZANE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME="Mizane"

# Database
# Local: Prisma uses PostgreSQL. Start Docker Postgres:
# docker compose up -d postgres
DATABASE_URL="postgresql://mizane:mizane@localhost:5432/mizane"

# Auth.js — AUTH_URL must equal NEXT_PUBLIC_APP_URL
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Optional Google login
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# AI — leave empty to use the built-in structured heuristic engine
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4.1-mini"

# Payments — mock is development-only. Staging public beta: PAYMENT_PROVIDER=disabled
PAYMENT_PROVIDER="mock"
PAYMENT_WEBHOOK_SECRET="dev-webhook-secret"
PAYZONE_ORIGINATOR_ID=""
PAYZONE_PASSWORD=""
PAYZONE_WEBHOOK_SECRET=""
PAYZONE_API_URL="https://api.payzone.ma"
PAYZONE_PAYMENT_PAGE_URL="https://payment.payzone.ma"
# Staging only. Forbidden when MIZANE_ENV=production.
PAYZONE_SANDBOX=""

# Storage — local is OK in development only.
# Staging (free beta): postgres (private BYTEA, no public URL) until Cloudflare R2 is connected.
# Production: s3/r2 only.
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="1"

# Retention (must match the privacy policy)
CV_RETENTION_DAYS="30"
CRON_SECRET="replace-with-cron-secret"

# Monitoring / SEO verification (optional)
SENTRY_DSN=""
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
INDEXNOW_KEY=""

# Admin seed — never use change-me-now. Production refuses weak/default passwords.
ADMIN_EMAIL="admin@mizane.ma"
ADMIN_PASSWORD=""

# Staging or production-like host. Copy to .env.production.local — never commit secrets.
# Staging: Payzone sandbox + public HTTPS URL + R2.
# Production: live Payzone, no PAYZONE_SANDBOX, no localhost.

NODE_ENV=production
MIZANE_ENV=staging
PAYZONE_SANDBOX=1
NEXT_PUBLIC_APP_URL="https://staging.example.com"
AUTH_URL="https://staging.example.com"
NEXT_PUBLIC_BRAND_NAME="Mizane"

DATABASE_URL="postgresql://mizane:mizane@localhost:5432/mizane"

AUTH_SECRET="replace-with-32-plus-random-chars"
AUTH_TRUST_HOST="true"

PAYMENT_PROVIDER="payzone"
PAYZONE_ORIGINATOR_ID=""
PAYZONE_PASSWORD=""
PAYZONE_WEBHOOK_SECRET=""
PAYZONE_API_URL="https://api.payzone.ma"
PAYZONE_PAYMENT_PAGE_URL="https://payment.payzone.ma"

STORAGE_DRIVER="s3"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="1"

CV_RETENTION_DAYS="30"
CRON_SECRET="replace-with-cron-secret"
SENTRY_DSN=""
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
INDEXNOW_KEY=""

ADMIN_EMAIL="admin@mizane.ma"
ADMIN_PASSWORD=""
